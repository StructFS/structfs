/// Featherweight Block interface for WASM components.
///
/// This WIT file defines the contract between the Featherweight runtime (host)
/// and WASM Blocks (guests). Blocks interact with the world exclusively through
/// the ll-store interface provided by the host.
///
/// The WASM boundary is an LL-store boundary: paths are byte components
/// (`list<list<u8>>`), data is raw bytes (`list<u8>`). The Block declares what
/// serialization format it speaks (JSON, CBOR, etc.), and the runtime uses
/// `CoreToLL` with the appropriate codec to bridge. The WIT never changes;
/// adding new formats requires zero WIT/bindgen work.

package featherweight:block@0.1.0;

/// The ll-store interface provided by the host to guest Blocks.
/// Paths are byte-component sequences; data is raw bytes.
interface ll-store {
    /// Read raw bytes from a path.
    /// Returns Ok(Some(data)) if found, Ok(None) if not found, Err on error.
    read: func(path: list<list<u8>>) -> result<option<list<u8>>, string>;

    /// Write raw bytes to a path.
    /// Returns Ok(result-path) on success, Err on error.
    write: func(path: list<list<u8>>, data: list<u8>) -> result<list<list<u8>>, string>;
}

/// The Block interface that guests must implement.
interface block {
    /// Return a JSON manifest describing the Block's capabilities.
    ///
    /// The manifest declares name, version, serialization format, and path
    /// interface. The runtime inspects it before wiring to discover what
    /// codec the Block speaks.
    ///
    /// This is intentionally opaque bytes rather than a structured WIT type.
    /// Three alternatives were considered and rejected:
    ///
    /// 1. Self-describe through the store (write to `/iso/self/interface`):
    ///    The manifest declares the serialization format the store *will*
    ///    speak — the runtime needs it before it can bridge the store.
    ///    Chicken-and-egg.
    ///
    /// 2. Structured WIT record: Blocks are not exclusively WASM components.
    ///    Web is a target surface. Encoding the manifest schema into WIT
    ///    marries us to the Component Model for a cross-runtime concern.
    ///
    /// 3. WASM custom section: Same portability problem — not every block
    ///    will be a WASM component.
    ///
    /// JSON is the lingua franca that works across every runtime target.
    /// The opaque return type is portable precisely because it does not
    /// depend on the host's type system.
    manifest: func() -> list<u8>;

    /// Run the Block. Called once when the Block starts.
    /// Returns Ok(()) on success or an error message on failure.
    run: func() -> result<_, string>;
}

/// The world that WASM Blocks live in.
world block-world {
    /// Host provides ll-store access
    import ll-store;

    /// Guest implements the Block
    export block;
}
